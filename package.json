{
  "name": "simple-bot",
  "version": "0.0.1",
  "description": "",
  "author": "Artem Koludarov",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier \"src/**/*.ts\" ",
    "format:fix": "prettier --write \"src/**/*.ts\" ",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{app,src,apps,libs,test}/**/*.ts\" --fix",
    "update-changelog": "node .gitlab/scripts/gitlab-changelog.js",
    "check:unused-exports": "npx ts-unused-exports ./tsconfig.json",
    "check:packages": "npx npm-check-updates -f '/^(?!.*eslint)/' --format group",
    "packages:fix": "ncu -u -f '/^(?!.*eslint)/' && npm i",
    "check:depcheck": "npx depcheck --ignores \"@types/multer\"",
    "dev:fix": "npm run lint:fix && npm run format:fix && npm run packages:fix",
    "pre-commit": "npm run lint && npm run format && npm run check:unused-exports && npm run check:packages && npm run check:depcheck"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.2",
    "@nestjs/common": "^10.3.9",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.9",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/microservices": "10.3.9",
    "@nestjs/mongoose": "^10.0.6",
    "@nestjs/platform-express": "^10.3.9",
    "@nestjs/typeorm": "^10.0.2",
    "@types/multer": "^1.4.11",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.4",
    "axios": "^1.7.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "google-auth-library": "^9.11.0",
    "google-spreadsheet": "^4.1.2",
    "helmet": "^7.1.0",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.4.1",
    "nestjs-cls": "^4.3.0",
    "node-telegram-bot-api": "^0.66.0",
    "pg": "^8.12.0",
    "pm2": "^5.4.0",
    "puppeteer": "^22.11.0",
    "puppeteer-core": "^22.11.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typeorm-naming-strategies": "^4.1.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@types/amqplib": "^0.10.5",
    "@types/node-telegram-bot-api": "^0.64.6",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "npm-check-updates": "^16.14.20",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2",
    "ts-unused-exports": "^10.1.0",
    "typescript": "^5.4.5"
  }
}
